# Greenlight — 環境變數範本
#
# 複製成 .env 再填。.env 已在 .gitignore 裡，絕對不要 commit。
# 正式環境（Cloud Run）走 Secret Manager，不用 .env 檔。

# ---------------------------------------------------------------------------
# Google Cloud
# ---------------------------------------------------------------------------
# 不要在這裡放 API 金鑰。本專案一律走 ADC（Application Default Credentials）：
#     本機 → gcloud auth application-default login
#     Cloud Run → 服務帳號自動帶入
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

# Gemini 3.1 Pro 只在 global endpoint 上提供，不在 us-central1。
# 用到 Pro 檔位時 location 要換成 global。
GCP_GLOBAL_LOCATION=global

# 生成的影片與參考圖存放位置
GCS_BUCKET=

# ---------------------------------------------------------------------------
# ClickHouse
# ---------------------------------------------------------------------------
# 連不上時系統會自動走降級模式（全程使用先驗值），不會壞掉。
# 也就是說「設錯了」跟「沒設」看起來一模一樣 —— 都只會在 log 留一行 info。
# 改完一定要跑 scripts/refine_memory.py 或看 /api/health 確認真的連上了。
#
# ── 本機 docker（開發用）────────────────────────────────────────────
#   docker compose -f deployment/clickhouse/docker-compose.yml up -d
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=greenlight
CLICKHOUSE_PASSWORD=greenlight_dev
CLICKHOUSE_DB=greenlight

# ── ClickHouse Cloud ────────────────────────────────────────────────
#   Connect 頁面會給 host / port / username / password，填上去即可。
#   HOST     xxxxxxx.us-central1.gcp.clickhouse.cloud
#   PORT     8443        ← 不是 8123。Cloud 走 HTTPS
#   USER     default
#   DB       greenlight  ← 自己建，不要用 default
#
# CLICKHOUSE_SECURE 平常不用設 —— port 8443 會自動判定為 TLS。
# 只有用非標準埠跑 TLS 時才需要明確指定 true。
#
# ClickHouse Cloud 的 30 天試用期會在使用期間內到期。
# 到期前要決定：加信用卡（記得開 auto-pause）或搬去 GCE 自架（約 $13/兩個月）。
# 決定之前這裡填 Cloud 的值就好，開發期試用完全夠用。

# ---------------------------------------------------------------------------
# 預算護欄
# ---------------------------------------------------------------------------
# 硬上限。這個值只是給執行期做二次確認用，真正的護欄設定在 config/pricing.yaml。
GREENLIGHT_BUDGET_CEILING_USD=100
