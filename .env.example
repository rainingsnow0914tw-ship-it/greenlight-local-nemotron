# Greenlight Local — optional environment variables
#
# You normally need none of these: the installed app keeps your keys and settings in
# Settings (stored encrypted on this computer). Use a .env only when running from source.
# Copy to .env next to this file. .env is git-ignored — never commit it.

# Nebius Token Factory key (Settings → ② Your keys does the same thing)
NEBIUS_API_KEY=
# TOKEN_FACTORY_BASE=https://api.tokenfactory.nebius.com/v1

# Where projects, media and settings live (default: %LOCALAPPDATA%\GreenlightLocal)
# GREENLIGHT_HOME=

# Director tuning (defaults shown)
# DIRECTOR_MAX_ROUNDS=10      # most rounds the director may take on one scene
# DIRECTOR_PATIENCE=3         # stop after this many rounds without improvement
# REVISION_ROUNDS=4           # producer review → revise cycles
# REASONING_BUDGET=12000      # thinking tokens per director call

# Render size for the local video model, in megapixels (default 0.92)
# RENDER_MEGAPIXELS=0.92
